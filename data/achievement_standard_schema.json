{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/math-knowledge/achievement-standards.schema.json",
  "title": "2022 Revised Korean High School Mathematics Achievement Standards",
  "type": "object",
  "required": [
    "metadata",
    "standards"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "dataset_name",
        "version",
        "curriculum_notice",
        "standard_count",
        "course_counts"
      ],
      "properties": {
        "dataset_name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "curriculum_notice": {
          "type": "string"
        },
        "standard_count": {
          "type": "integer",
          "const": 130
        },
        "course_counts": {
          "type": "object"
        }
      }
    },
    "standards": {
      "type": "array",
      "minItems": 130,
      "maxItems": 130,
      "items": {
        "type": "object",
        "required": [
          "id",
          "course_id",
          "course_name",
          "course_category",
          "unit_id",
          "unit_name",
          "code",
          "content",
          "source_status",
          "source",
          "guidance_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "course_id": {
            "type": "string"
          },
          "course_name": {
            "type": "string"
          },
          "course_category": {
            "type": "string"
          },
          "unit_id": {
            "type": "string"
          },
          "unit_name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "source_status": {
            "const": "official_pdf_transcribed"
          },
          "guidance_id": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "required": [
              "document",
              "document_date",
              "printed_pages",
              "pdf_text_lines",
              "web_source_ref",
              "official_url"
            ],
            "properties": {
              "document": {
                "type": "string"
              },
              "document_date": {
                "type": "string"
              },
              "printed_pages": {
                "type": "string"
              },
              "pdf_text_lines": {
                "type": "string"
              },
              "web_source_ref": {
                "type": "string"
              },
              "official_url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}