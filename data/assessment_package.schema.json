{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Math Inquiry Assessment Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "selection",
    "design",
    "item",
    "formative_check",
    "validation"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "package_id",
        "generation_mode",
        "created_at_utc",
        "teacher_review_required"
      ],
      "properties": {
        "package_id": {
          "type": "string"
        },
        "generation_mode": {
          "type": "string",
          "enum": [
            "offline_scaffold",
            "gemini_structured",
            "authored_demo"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at_utc": {
          "type": "string"
        },
        "teacher_review_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "selection": {
      "type": "object",
      "required": [
        "course_id",
        "course_name",
        "unit_id",
        "unit_name",
        "standard_code",
        "standard_content",
        "concept_ids",
        "concept_names",
        "official_source"
      ],
      "properties": {
        "course_id": {
          "type": "string"
        },
        "course_name": {
          "type": "string"
        },
        "unit_id": {
          "type": "string"
        },
        "unit_name": {
          "type": "string"
        },
        "standard_code": {
          "type": "string"
        },
        "standard_content": {
          "type": "string"
        },
        "concept_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "concept_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "official_source": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "design": {
      "type": "object",
      "required": [
        "principle_ids",
        "context",
        "driving_question",
        "learning_objectives",
        "inquiry_steps",
        "representations",
        "misconception_support",
        "differentiation"
      ],
      "properties": {
        "principle_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "string"
        },
        "driving_question": {
          "type": "string"
        },
        "learning_objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "inquiry_steps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "phase",
              "teacher_action",
              "student_evidence"
            ],
            "properties": {
              "phase": {
                "type": "string"
              },
              "teacher_action": {
                "type": "string"
              },
              "student_evidence": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "representations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "misconception_support": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "misconception_id",
              "diagnostic_question",
              "corrective_feedback"
            ],
            "properties": {
              "misconception_id": {
                "type": "string"
              },
              "diagnostic_question": {
                "type": "string"
              },
              "corrective_feedback": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "differentiation": {
          "type": "object",
          "required": [
            "support",
            "extension"
          ],
          "properties": {
            "support": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extension": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": [
        "item_type",
        "cognitive_demand",
        "prompt",
        "expected_answer",
        "solution_steps",
        "rubric"
      ],
      "properties": {
        "item_type": {
          "type": "string"
        },
        "cognitive_demand": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "expected_answer": {
          "type": "string"
        },
        "solution_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "rubric": {
          "type": "object",
          "required": [
            "total_points",
            "criteria"
          ],
          "properties": {
            "total_points": {
              "type": "integer",
              "minimum": 1
            },
            "criteria": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": {
                "type": "object",
                "required": [
                  "criterion",
                  "points",
                  "levels"
                ],
                "properties": {
                  "criterion": {
                    "type": "string"
                  },
                  "points": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "levels": {
                    "type": "object",
                    "required": [
                      "A",
                      "B",
                      "C",
                      "D",
                      "E"
                    ],
                    "properties": {
                      "A": {
                        "type": "string"
                      },
                      "B": {
                        "type": "string"
                      },
                      "C": {
                        "type": "string"
                      },
                      "D": {
                        "type": "string"
                      },
                      "E": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "formative_check": {
      "type": "object",
      "required": [
        "questions",
        "success_criteria"
      ],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "checks",
        "blocking_errors",
        "warnings"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status",
              "detail"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "blocking_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
